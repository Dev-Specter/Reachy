<?xml version="1.0"?>
<package format="3">

  <name>reachy_rl_control</name>
  <version>0.0.1</version>

  <description>
    ROS 2 package for controlling Reachy in Gazebo and developing
    reinforcement learning environments.
  </description>

  <maintainer email="abhinav@example.com">
    abhinav
  </maintainer>

  <license>MIT</license>

  <!-- Build system -->
  <buildtool_depend>ament_python</buildtool_depend>

  <!-- Python / ROS 2 -->
  <exec_depend>rclpy</exec_depend>

  <!-- Used for /cmd_vel -->
  <exec_depend>geometry_msgs</exec_depend>

  <!-- Used for /odom -->
  <exec_depend>nav_msgs</exec_depend>

  <!-- Used for /reset_world and /reset_simulation -->
  <exec_depend>std_srvs</exec_depend>

  <depend>sensor_msgs</depend>

  <export>
    <build_type>ament_python</build_type>
  </export>

</package>
